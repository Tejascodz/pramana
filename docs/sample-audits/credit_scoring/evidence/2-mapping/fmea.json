[
  {
    "check_id": "governance.risk_classification",
    "controls": [
      "NIST:MAP-1.1",
      "NIST:MAP-3.3",
      "NIST:MAP-1.5",
      "NIST:GOVERN-1.1",
      "ISO42001:A.9.4",
      "ISO42001:A.5.2",
      "EUAIA:Art-5",
      "EUAIA:Art-6",
      "INDIA:PILLAR-RISK-MITIGATION",
      "ISO42005:5.4",
      "ISO42005:5.5",
      "ISO42005:6.3.4"
    ],
    "detection": "Risk classification",
    "effect": "Wrong obligations applied; high-risk duties missed",
    "failure_mode": "System deployed without a documented risk classification"
  },
  {
    "check_id": "data_quality.integrity",
    "controls": [
      "NIST:MAP-2.3",
      "NIST:MEASURE-2.1",
      "ISO42001:A.7.4",
      "ISO42001:A.7.6",
      "ISO42001:A.4.3",
      "EUAIA:Art-10",
      "ISO42005:6.4"
    ],
    "detection": "Data quality",
    "effect": "Biased or over-optimistic validation results",
    "failure_mode": "Missing values, duplicates, imbalance or target leakage in data"
  },
  {
    "check_id": "performance.discrimination",
    "controls": [
      "NIST:MEASURE-2.3",
      "NIST:MEASURE-2.5",
      "NIST:MEASURE-2.1",
      "NIST:MANAGE-1.1",
      "ISO42001:A.6.2.4",
      "EUAIA:Art-15",
      "INDIA:SUTRA-SAFETY"
    ],
    "detection": "Predictive performance",
    "effect": "Wrong decisions at scale; financial and customer harm",
    "failure_mode": "Model does not separate good and bad outcomes well enough for its intended use"
  },
  {
    "check_id": "calibration.reliability",
    "controls": [
      "NIST:MEASURE-2.5",
      "NIST:MEASURE-2.9",
      "ISO42001:A.6.2.4",
      "EUAIA:Art-15",
      "INDIA:SUTRA-UNDERSTANDABLE"
    ],
    "detection": "Calibration",
    "effect": "Mispriced risk; misleading scores shown to reviewers",
    "failure_mode": "Predicted probabilities do not match observed rates"
  },
  {
    "check_id": "fairness.group_parity",
    "controls": [
      "NIST:MEASURE-2.11",
      "NIST:MAP-5.1",
      "ISO42001:A.5.4",
      "ISO42001:A.7.4",
      "EUAIA:Art-10",
      "INDIA:SUTRA-FAIRNESS",
      "NIST-GAI:HARMFUL-BIAS",
      "ISO42005:6.8.2"
    ],
    "detection": "Group fairness",
    "effect": "Discrimination against applicants; legal and reputational exposure",
    "failure_mode": "Outcomes or error rates differ materially across protected groups"
  },
  {
    "check_id": "fairness.intersectional",
    "controls": [
      "NIST:MEASURE-2.11",
      "ISO42001:A.5.4",
      "EUAIA:Art-10",
      "INDIA:SUTRA-FAIRNESS",
      "ISO42005:6.8.2"
    ],
    "detection": "Intersectional fairness",
    "effect": "Sub-group harm that single-attribute tests miss",
    "failure_mode": "Disparity hidden inside combinations of attributes (e.g. rural women)"
  },
  {
    "check_id": "fairness.proxy_features",
    "controls": [
      "NIST:MEASURE-2.11",
      "NIST:MAP-2.3",
      "ISO42001:A.7.4",
      "ISO42001:A.7.6",
      "EUAIA:Art-10",
      "INDIA:SUTRA-FAIRNESS"
    ],
    "detection": "Proxy-feature screening",
    "effect": "Indirect discrimination even when protected attributes are excluded",
    "failure_mode": "Model inputs act as proxies for protected attributes"
  },
  {
    "check_id": "robustness.perturbation",
    "controls": [
      "NIST:MEASURE-2.5",
      "NIST:MEASURE-2.7",
      "NIST:MEASURE-2.6",
      "ISO42001:A.6.2.4",
      "EUAIA:Art-15",
      "INDIA:SUTRA-SAFETY",
      "ISO42005:6.8.3"
    ],
    "detection": "Robustness to perturbation",
    "effect": "Unstable, unrepeatable outcomes; exploitable behaviour",
    "failure_mode": "Small input noise or missing values flip decisions"
  },
  {
    "check_id": "drift.population_stability",
    "controls": [
      "NIST:MEASURE-2.4",
      "NIST:MEASURE-4.3",
      "NIST:MANAGE-4.1",
      "NIST:MANAGE-2.2",
      "ISO42001:A.6.2.6",
      "EUAIA:Art-72",
      "INDIA:SUTRA-SAFETY",
      "ISO42005:5.12"
    ],
    "detection": "Data and prediction drift",
    "effect": "Silent performance and fairness decay after deployment",
    "failure_mode": "Production data no longer resembles the data the model was validated on"
  },
  {
    "check_id": "explainability.feature_importance",
    "controls": [
      "NIST:MEASURE-2.9",
      "NIST:MAP-2.2",
      "ISO42001:A.6.2.7",
      "ISO42001:A.8.2",
      "EUAIA:Art-13",
      "INDIA:SUTRA-UNDERSTANDABLE"
    ],
    "detection": "Decision drivers",
    "effect": "Decisions cannot be explained to customers, reviewers or regulators",
    "failure_mode": "Decision drivers are unknown, undocumented or include prohibited inputs"
  },
  {
    "check_id": "privacy.pii_exposure",
    "controls": [
      "NIST:MEASURE-2.10",
      "ISO42001:A.7.2",
      "ISO42001:A.7.5",
      "EUAIA:Art-10",
      "INDIA:DPDP-2023",
      "NIST-GAI:DATA-PRIVACY"
    ],
    "detection": "Personal-data exposure",
    "effect": "Unnecessary personal-data processing; breach impact",
    "failure_mode": "Direct identifiers present in modelling or evaluation datasets"
  },
  {
    "check_id": "privacy.membership_inference",
    "controls": [
      "NIST:MEASURE-2.10",
      "NIST:MEASURE-2.7",
      "ISO42001:A.6.2.4",
      "EUAIA:Art-15",
      "INDIA:DPDP-2023"
    ],
    "detection": "Membership-inference risk",
    "effect": "Re-identification of individuals in the training set",
    "failure_mode": "Model memorizes training records so membership can be inferred"
  },
  {
    "check_id": "documentation.model_card",
    "controls": [
      "NIST:MAP-2.2",
      "NIST:MAP-3.5",
      "NIST:GOVERN-4.2",
      "NIST:MEASURE-2.8",
      "ISO42001:A.6.2.3",
      "ISO42001:A.6.2.7",
      "ISO42001:A.8.2",
      "EUAIA:Art-11",
      "EUAIA:Art-13",
      "EUAIA:Art-14",
      "INDIA:SUTRA-UNDERSTANDABLE",
      "INDIA:SUTRA-ACCOUNTABILITY",
      "ISO42005:6.3.4",
      "ISO42005:6.3.5",
      "ISO42005:6.5"
    ],
    "detection": "Documentation and claims",
    "effect": "Misuse outside scope; failed technical-documentation review",
    "failure_mode": "Intended use, limitations and oversight measures are not documented"
  },
  {
    "check_id": "audit.detector_sensitivity",
    "controls": [
      "NIST:MEASURE-2.13",
      "NIST:MEASURE-1.2",
      "ISO42001:A.6.2.4"
    ],
    "detection": "Audit self-test (canaries)",
    "effect": "False assurance from the audit itself",
    "failure_mode": "Audit tests fail to detect a defect that is known to exist"
  }
]